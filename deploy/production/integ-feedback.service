[Unit]
Description=Integ Feedback API (discuss.integ.life)
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=integ-feedback
Group=integ-feedback
EnvironmentFile=/etc/integ-feedback.env
ExecStart=/usr/local/bin/integ-feedback
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
